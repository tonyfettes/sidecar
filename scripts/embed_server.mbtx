----
import {
  "moonbitlang/core/async/fs",
  "moonbitlang/core/cmp",
  "moonbitlang/core/compress/gzip",
  "moonbitlang/core/env",
}
----

///|
/// Gzip-compress cross-compiled binaries and generate a MoonBit embedding file.
///
/// Default usage (from repo root, after `cd server && zig build dist`):
///
///   moon run --target native scripts/embed_server.mbtx
///
/// Reusable for downstream plugins:
///
///   moon run --target native scripts/embed_server.mbtx -- \
///     --dist-dir path/to/dist \
///     --out embedded_plugin.generated.mbt \
///     --map-name embedded_plugins \
///     --type-prefix @sidecar.
const BYTES_PER_LINE : Int = 128

///|
struct Config {
  mut dist_dir : String
  mut out_path : String
  mut map_name : String
  mut type_prefix : String
  mut is_public : Bool
}

///|
struct Entry {
  platform : String
  filename : String
  sha256 : String
  raw_len : Int
  gzip_bytes : Bytes
}

///|
fn parse_args(args : ArrayView[String]) -> Config raise {
  let cfg : Config = {
    dist_dir: "server/zig-out/dist",
    out_path: "embedded_server.generated.mbt",
    map_name: "embedded_servers",
    type_prefix: "",
    is_public: false,
  }
  let mut i = 0
  while i < args.length() {
    match args[i] {
      "--dist-dir" => {
        guard i + 1 < args.length() else { fail("missing value for --dist-dir") }
        cfg.dist_dir = args[i + 1]
        i += 2
      }
      "--out" => {
        guard i + 1 < args.length() else { fail("missing value for --out") }
        cfg.out_path = args[i + 1]
        i += 2
      }
      "--map-name" => {
        guard i + 1 < args.length() else { fail("missing value for --map-name") }
        cfg.map_name = args[i + 1]
        i += 2
      }
      "--type-prefix" => {
        guard i + 1 < args.length() else {
          fail("missing value for --type-prefix")
        }
        cfg.type_prefix = args[i + 1]
        i += 2
      }
      "--public" => {
        cfg.is_public = true
        i += 1
      }
      other => fail("unknown argument: \{other}")
    }
  }
  cfg
}

///|
fn rotr(x : UInt, n : Int) -> UInt {
  (x >> n) | (x << (32 - n))
}

///|
fn sha256_hex(data : Bytes) -> String {
  let k : FixedArray[UInt] = [
    0x428a2f98U, 0x71374491U, 0xb5c0fbcfU, 0xe9b5dba5U, 0x3956c25bU, 0x59f111f1U,
    0x923f82a4U, 0xab1c5ed5U, 0xd807aa98U, 0x12835b01U, 0x243185beU, 0x550c7dc3U,
    0x72be5d74U, 0x80deb1feU, 0x9bdc06a7U, 0xc19bf174U, 0xe49b69c1U, 0xefbe4786U,
    0x0fc19dc6U, 0x240ca1ccU, 0x2de92c6fU, 0x4a7484aaU, 0x5cb0a9dcU, 0x76f988daU,
    0x983e5152U, 0xa831c66dU, 0xb00327c8U, 0xbf597fc7U, 0xc6e00bf3U, 0xd5a79147U,
    0x06ca6351U, 0x14292967U, 0x27b70a85U, 0x2e1b2138U, 0x4d2c6dfcU, 0x53380d13U,
    0x650a7354U, 0x766a0abbU, 0x81c2c92eU, 0x92722c85U, 0xa2bfe8a1U, 0xa81a664bU,
    0xc24b8b70U, 0xc76c51a3U, 0xd192e819U, 0xd6990624U, 0xf40e3585U, 0x106aa070U,
    0x19a4c116U, 0x1e376c08U, 0x2748774cU, 0x34b0bcb5U, 0x391c0cb3U, 0x4ed8aa4aU,
    0x5b9cca4fU, 0x682e6ff3U, 0x748f82eeU, 0x78a5636fU, 0x84c87814U, 0x8cc70208U,
    0x90befffaU, 0xa4506cebU, 0xbef9a3f7U, 0xc67178f2U,
  ]
  let mut h0 = 0x6a09e667U
  let mut h1 = 0xbb67ae85U
  let mut h2 = 0x3c6ef372U
  let mut h3 = 0xa54ff53aU
  let mut h4 = 0x510e527fU
  let mut h5 = 0x9b05688cU
  let mut h6 = 0x1f83d9abU
  let mut h7 = 0x5be0cd19U

  let len = data.length()
  let bit_len = len.to_uint64() * 8UL
  let pad_len = {
    let rem = (len + 9) % 64
    if rem == 0 {
      len + 9
    } else {
      len + 9 + (64 - rem)
    }
  }
  let padded = FixedArray::make(pad_len, b'\x00')
  for i in 0..<len {
    padded[i] = data[i]
  }
  padded[len] = b'\x80'
  for i in 0..<8 {
    let shift = (7 - i) * 8
    padded[pad_len - 8 + i] = ((bit_len >> shift) & 0xFFUL).to_byte()
  }

  let w = FixedArray::make(64, 0U)
  let mut off = 0
  while off < pad_len {
    for i in 0..<16 {
      let j = off + i * 4
      w[i] = (padded[j].to_uint() << 24) |
        (padded[j + 1].to_uint() << 16) |
        (padded[j + 2].to_uint() << 8) |
        padded[j + 3].to_uint()
    }
    for i in 16..<64 {
      let s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3)
      let s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10)
      w[i] = w[i - 16] + s0 + w[i - 7] + s1
    }
    let mut a = h0
    let mut b = h1
    let mut c = h2
    let mut d = h3
    let mut e = h4
    let mut f = h5
    let mut g = h6
    let mut h = h7
    for i in 0..<64 {
      let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
      let ch = (e & f) ^ (e.lnot() & g)
      let temp1 = h + s1 + ch + k[i] + w[i]
      let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
      let maj = (a & b) ^ (a & c) ^ (b & c)
      let temp2 = s0 + maj
      h = g
      g = f
      f = e
      e = d + temp1
      d = c
      c = b
      b = a
      a = temp1 + temp2
    }
    h0 = h0 + a
    h1 = h1 + b
    h2 = h2 + c
    h3 = h3 + d
    h4 = h4 + e
    h5 = h5 + f
    h6 = h6 + g
    h7 = h7 + h
    off += 64
  }

  let hex_chars = "0123456789abcdef"
  let sb = StringBuilder(capacity=64)
  for word in [h0, h1, h2, h3, h4, h5, h6, h7] {
    for shift in [28, 24, 20, 16, 12, 8, 4, 0] {
      let nibble = ((word >> shift) & 0xFU).reinterpret_as_int()
      sb.write_char(hex_chars[nibble].to_int().unsafe_to_char())
    }
  }
  sb.to_string()
}

///|
fn binding_name(map_name : String, platform : String) -> String {
  let clean = platform.replace_all(old="-", new="_")
  "\{map_name}_\{clean}_gz"
}

///|
fn write_bytes_literal(out : StringBuilder, data : Bytes) -> Unit {
  let hex_chars = "0123456789abcdef"
  let mut start = 0
  while start < data.length() {
    let end = @cmp.minimum(start + BYTES_PER_LINE, data.length())
    out.write_string(" ")
    for i in start..<end {
      let b = data[i].to_int()
      let hi = (b >> 4) & 0xF
      let lo = b & 0xF
      out.write_string(" 0x")
      out.write_char(hex_chars[hi].to_int().unsafe_to_char())
      out.write_char(hex_chars[lo].to_int().unsafe_to_char())
      out.write_char(',')
    }
    out.write_char('\n')
    start = end
  }
}

///|
async fn main {
  let cfg = parse_args(@env.args()[1:])
  let plat_names = @fs.readdir(cfg.dist_dir, sort=true)
  plat_names.sort()
  let entries : Array[Entry] = []

  for plat in plat_names {
    let plat_dir = "\{cfg.dist_dir}/\{plat}"
    if !(@fs.kind(plat_dir) is @fs.Directory) {
      continue
    }
    let files = @fs.readdir(plat_dir, sort=true)
    if files.is_empty() {
      continue
    }
    guard files is [filename] else {
      fail("expected 1 artifact in \{plat_dir}, found \{files.length()}")
    }
    let raw = @fs.read_binary("\{plat_dir}/\{filename}")
    let sha = sha256_hex(raw)
    let gz = @gzip.compress(raw[:])
    entries.push({
      platform: plat,
      filename,
      sha256: sha,
      raw_len: raw.length(),
      gzip_bytes: gz,
    })
  }

  guard !entries.is_empty() else {
    fail("no platform artifacts found under \{cfg.dist_dir}")
  }

  let vis = if cfg.is_public { "pub " } else { "" }
  let ty = "\{cfg.type_prefix}EmbeddedArtifact"
  let out = StringBuilder()
  out.write_string("///|\n")
  out.write_string(
    "/// Generated by `scripts/embed_server.mbtx` from `\{cfg.dist_dir}`.\n",
  )
  out.write_string("/// Do not edit by hand.\n")
  out.write_string("\{vis}let \{cfg.map_name} : Map[String, \{ty}] = {\n")

  let mut total_raw = 0
  let mut total_gz = 0
  for e in entries {
    total_raw += e.raw_len
    total_gz += e.gzip_bytes.length()
    let ident = binding_name(cfg.map_name, e.platform)
    out.write_string(
      "  \"\{e.platform}\": \{ty}::new(filename=\"\{e.filename}\", sha256=\"\{e.sha256}\", gzip_bytes=\{ident}),\n",
    )
  }
  out.write_string("}\n")

  for e in entries {
    let ident = binding_name(cfg.map_name, e.platform)
    out.write_string("\n///|\n")
    out.write_string(
      "// \{e.platform}/\{e.filename}: raw=\{e.raw_len} bytes, gzip=\{e.gzip_bytes.length()} bytes, sha256=\{e.sha256[:16]}\n",
    )
    out.write_string("let \{ident} : Bytes = [\n")
    write_bytes_literal(out, e.gzip_bytes)
    out.write_string("]\n")
  }

  @fs.write_text(cfg.out_path, out.to_string())

  println("Generated \{cfg.out_path} (\{entries.length()} platforms):")
  for e in entries {
    let pct = e.gzip_bytes.length() * 100 / e.raw_len
    println(
      "  \{e.platform} (\{e.filename}): raw=\{e.raw_len}B -> gzip=\{e.gzip_bytes.length()}B (\{pct}%) sha256=\{e.sha256[:12]}",
    )
  }
  println("  TOTAL: raw=\{total_raw}B -> gzip=\{total_gz}B")
}
